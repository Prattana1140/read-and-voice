PORT=3000
PMA_BLOWFISH_SECRET=change-this-32-character-secret

# Database mode:
# - auto: local config first on your machine, provider config first on hosted platforms
# - local: force LOCAL_DB_* / LOCAL_DATABASE_URL first
# - cloud: force CLOUD_DB_* / CLOUD_DATABASE_URL first
DB_MODE=auto

# Default MySQL config. This remains supported for simple single-database setup.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=read_and_voice

# Optional local MySQL config. Use DB_MODE=local to force this set.
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=3306
LOCAL_DB_USER=root
LOCAL_DB_PASSWORD=
LOCAL_DB_NAME=read_and_voice
# LOCAL_DATABASE_URL=mysql://user:password@localhost:3306/read_and_voice

# Optional cloud/provider MySQL config. Use DB_MODE=cloud to force this set.
CLOUD_DB_HOST=mysql
CLOUD_DB_PORT=3306
CLOUD_DB_USER=readvoice
CLOUD_DB_PASSWORD=replace-with-render-mysql-password
CLOUD_DB_NAME=read_and_voice
# CLOUD_DATABASE_URL=mysql://user:password@host:3306/read_and_voice

# Render example for your backend service Environment tab:
# DB_MODE=cloud
# DB_HOST=mysql
# DB_PORT=3306
# DB_USER=readvoice
# DB_PASSWORD=replace-with-render-mysql-password
# DB_NAME=read_and_voice
# DB_SSL=false
# DB_SSL_MODE=disable
# PORT=10000
# API_PUBLIC_URL=https://your-backend.onrender.com

# You can also use a single connection string instead:
# DATABASE_URL=mysql://user:password@host:3306/read_and_voice
#
# Optional SSL/TLS for managed MySQL providers such as Aiven:
# DB_SSL=true
# DB_SSL_MODE=require
# Use DB_SSL=false and DB_SSL_MODE=disable for providers that do not use SSL, such as some MySQL public proxies.
# DB_SSL_REJECT_UNAUTHORIZED=false
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# DB_SSL_CA_BASE64=
# DB_SSL_CA_FILE=./certs/ca.pem
#
# Legacy provider variable names also work:
# MYSQLHOST=
# MYSQLPORT=
# MYSQLUSER=
# MYSQLPASSWORD=
# MYSQLDATABASE=
# MYSQL_URL=
DB_CONNECT_TIMEOUT_MS=8000

# Guest book preview controls
GUEST_PREVIEW_PAGE_LIMIT=1
GUEST_PREVIEW_CHAR_LIMIT=1500

JWT_SECRET=change-this-secret

FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000

# Production safety
# NODE_ENV=production
# ENABLE_MOCK_PAYMENTS=false
# ENABLE_MOCK_COIN_TOPUP=false
# ALLOW_PASSWORD_RESET_PREVIEW=false

# Payment gateway integration
# PAYMENT_CHECKOUT_URL_TEMPLATE=https://your-payment-provider.example/checkout?order_id={topup_id}&amount={amount}
# PAYMENT_WEBHOOK_SECRET=
# Manual payment fallback (bank transfer + admin approval)
# MANUAL_PAYMENT_ENABLED=true
# MANUAL_PAYMENT_INSTRUCTIONS=โอนเงินเข้าบัญชี ... แล้วแจ้งเลขรายการ {topup_id} จำนวน {amount} บาท
MOCK_PAYMENT_WEBHOOK_SECRET=

# Real email delivery (Resend)
# RESEND_API_KEY=
# EMAIL_FROM=hello@your-domain.com
# EMAIL_FROM_NAME=Read and Voice

# Optional custom email delivery webhook
# EMAIL_WEBHOOK_URL=
# EMAIL_WEBHOOK_SECRET=
# PASSWORD_RESET_EMAIL_WEBHOOK_URL=
# PASSWORD_RESET_EMAIL_WEBHOOK_SECRET=

# Optional outbound notification delivery webhook
# NOTIFICATION_DELIVERY_WEBHOOK_URL=
# NOTIFICATION_DELIVERY_WEBHOOK_SECRET=

# LINE Login
# Callback URL: http://localhost:3000/api/auth/oauth/line/callback
# Production callback URL: https://your-api-domain.com/api/auth/oauth/line/callback
# LINE_CLIENT_ID must be the numeric LINE Login Channel ID, not the Channel secret.
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
LINE_SCOPE=openid profile email

# OCR for scanned PDFs and scanned images
ENABLE_OCR=false
OCR_LANG=tha+eng
# TESSERACT_COMMAND=C:\Program Files\Tesseract-OCR\tesseract.exe
# OCR_PYTHON_COMMAND=python
# OCR_PSM=3
# OCR_CONCURRENCY=3
# OCR_RENDER_SCALE=2
# TESSERACT_JS_LANG_PATH=./
