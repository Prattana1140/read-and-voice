PORT=3000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=read_and_voice
JWT_SECRET=change-this-secret

FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000

# Facebook Login
# Callback URL: http://localhost:3000/api/auth/oauth/facebook/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Google OAuth
# Authorized redirect URI: http://localhost:3000/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LINE Login
# Callback URL: http://localhost:3000/api/auth/oauth/line/callback
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=

# Sign in with Apple
# Return URL: http://localhost:3000/api/auth/oauth/apple/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Or set APPLE_CLIENT_SECRET directly instead of TEAM_ID/KEY_ID/PRIVATE_KEY.
APPLE_CLIENT_SECRET=
