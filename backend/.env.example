DB_MODE=local
PORT=3000
=
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=3306
LOCAL_DB_USER=root
LOCAL_DB_PASSWORD=
LOCAL_DB_NAME=read_and_voice
=
DB_SSL=false
DB_SSL_MODE=disable
DB_SSL_REJECT_UNAUTHORIZED=false
=
NODE_ENV=development
ENABLE_MOCK_COIN_TOPUP=
=
JWT_SECRET=change-this-secret
API_PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
=
RESEND_API_KEY=
=
EMAIL_FROM=hello@example.com
EMAIL_FROM_NAME=Read and Voice
=
MANUAL_PAYMENT_ENABLED=true
MANUAL_PAYMENT_INSTRUCTIONS=Please follow the payment instructions from the admin and include transaction {topup_id} for amount {amount}.
=
ENABLE_OCR=false
OCR_PYTHON_COMMAND=
OCR_ENGINE=auto
PADDLEOCR_LANG=th
PADDLEOCR_MIN_SCORE=0.35
PADDLEOCR_DPI=320
OCR_LANG=tha+eng
OCR_CONCURRENCY=3
OCR_RENDER_SCALE=2
OCR_PREPROCESS=true
OCR_THRESHOLD=180
TESSERACT_COMMAND=tesseract

ENABLE_STT=false
STT_COMMAND=
STT_ARGS="{backend}/services/scripts/stt_faster_whisper.py" {input} --language {language}
STT_LANGUAGE=th
STT_MODEL=tiny
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_CACHE_DIR=.cache/huggingface
STT_TIMEOUT_MS=120000
STT_MAX_UPLOAD_BYTES=8388608
STT_HEALTHCHECK_ARGS="{backend}/services/scripts/stt_faster_whisper.py" --healthcheck

ENABLE_SERVER_TTS=false
SERVER_TTS_COMMAND=
SERVER_TTS_VOICE=th-TH-PremwadeeNeural
SERVER_TTS_MAX_CHARS=1200
SERVER_TTS_TIMEOUT_MS=120000
SERVER_TTS_RATE=+0%
SERVER_TTS_PITCH=+0Hz
SERVER_TTS_VOLUME=+0%

LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
LINE_SCOPE=
LINE_REDIRECT_URI=
=
DATABASE_URL=
git=
=
SMOKE_USER_EMAIL=
SMOKE_USER_PASSWORD=
SMOKE_WRITER_EMAIL=
SMOKE_WRITER_PASSWORD=
SMOKE_ADMIN_EMAIL=
SMOKE_ADMIN_PASSWORD=
SMOKE_SUPERADMIN_EMAIL=
SMOKE_SUPERADMIN_PASSWORD=
