PORT=3000

# Database mode:
# - auto: local config first on your machine, provider config first on hosted platforms
# - local: force LOCAL_DB_* / LOCAL_DATABASE_URL first
# - cloud: force CLOUD_DB_* / CLOUD_DATABASE_URL first
DB_MODE=local

# Local MySQL for development
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=3306
LOCAL_DB_USER=root
LOCAL_DB_PASSWORD=
LOCAL_DB_NAME=read_and_voice

# Local MySQL usually does not support SSL. Enable SSL only for cloud providers that require it.
DB_SSL=false
DB_SSL_MODE=disable
DB_SSL_REJECT_UNAUTHORIZED=false
DB_CONNECT_TIMEOUT_MS=8000

JWT_SECRET=change-this-secret
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000

# Guest book preview controls
GUEST_PREVIEW_PAGE_LIMIT=1
GUEST_PREVIEW_CHAR_LIMIT=1500

# Payment and email development defaults
MANUAL_PAYMENT_ENABLED=true
MANUAL_PAYMENT_INSTRUCTIONS=Please follow the payment instructions from the admin and include transaction {topup_id} for amount {amount}.
MOCK_PAYMENT_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=hello@example.com
EMAIL_FROM_NAME=Read and Voice

# LINE Login
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
LINE_SCOPE=openid profile email

# Facebook Login
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# OCR for scanned PDFs and scanned images
ENABLE_OCR=false
OCR_LANG=tha+eng
OCR_CONCURRENCY=3
OCR_RENDER_SCALE=2
TESSERACT_COMMAND=tesseract

# Cloud database example. Use DB_MODE=cloud and DB_SSL=true if your provider requires SSL.
DATABASE_URL=
