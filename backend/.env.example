PORT=3000

# Local MySQL / Railway public proxy
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=read_and_voice

# Railway MySQL also works with its default variable names:
# MYSQLHOST=
# MYSQLPORT=
# MYSQLUSER=
# MYSQLPASSWORD=
# MYSQLDATABASE=
# DATABASE_URL=
DB_CONNECT_TIMEOUT_MS=8000

# Guest book preview controls
GUEST_PREVIEW_PAGE_LIMIT=1
GUEST_PREVIEW_CHAR_LIMIT=1500

JWT_SECRET=change-this-secret

FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000

# Production safety
# NODE_ENV=production
# ENABLE_MOCK_PAYMENTS=false
# ENABLE_MOCK_COIN_TOPUP=false
# ALLOW_PASSWORD_RESET_PREVIEW=false

# Payment gateway integration
# PAYMENT_CHECKOUT_URL_TEMPLATE=https://your-payment-provider.example/checkout?order_id={topup_id}&amount={amount}
# PAYMENT_WEBHOOK_SECRET=
# Manual payment fallback (bank transfer + admin approval)
# MANUAL_PAYMENT_ENABLED=true
# MANUAL_PAYMENT_INSTRUCTIONS=โอนเงินเข้าบัญชี ... แล้วแจ้งเลขรายการ {topup_id} จำนวน {amount} บาท
MOCK_PAYMENT_WEBHOOK_SECRET=

# Real email delivery (Resend)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# EMAIL_FROM=hello@your-domain.com
# EMAIL_FROM_NAME=Read and Voice

# Optional custom email delivery webhook
# EMAIL_WEBHOOK_URL=
# EMAIL_WEBHOOK_SECRET=
# PASSWORD_RESET_EMAIL_WEBHOOK_URL=
# PASSWORD_RESET_EMAIL_WEBHOOK_SECRET=

# Optional outbound notification delivery webhook
# NOTIFICATION_DELIVERY_WEBHOOK_URL=
# NOTIFICATION_DELIVERY_WEBHOOK_SECRET=

# LINE Login
# Callback URL: http://localhost:3000/api/auth/oauth/line/callback
# Production callback URL: https://your-api-domain.com/api/auth/oauth/line/callback
# LINE_CLIENT_ID must be the numeric LINE Login Channel ID, not the Channel secret.
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
LINE_SCOPE=openid profile email

# OCR for scanned PDFs and scanned images
ENABLE_OCR=false
OCR_LANG=tha+eng
# TESSERACT_COMMAND=C:\Program Files\Tesseract-OCR\tesseract.exe
# OCR_PYTHON_COMMAND=python
# OCR_PSM=3
# TESSERACT_JS_LANG_PATH=./
