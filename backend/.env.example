PORT=3000

# Local MySQL / Railway public proxy
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=read_and_voice

# Railway MySQL also works with its default variable names:
# MYSQLHOST=
# MYSQLPORT=
# MYSQLUSER=
# MYSQLPASSWORD=
# MYSQLDATABASE=
# DATABASE_URL=
DB_CONNECT_TIMEOUT_MS=8000

# Guest book preview controls
GUEST_PREVIEW_PAGE_LIMIT=1
GUEST_PREVIEW_CHAR_LIMIT=1500

JWT_SECRET=change-this-secret

FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000
MOCK_PAYMENT_WEBHOOK_SECRET=

# Facebook Login
# Callback URL: http://localhost:3000/api/auth/oauth/facebook/callback
# Production callback URL: https://your-api-domain.com/api/auth/oauth/facebook/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_API_VERSION=v25.0
FACEBOOK_SCOPE=public_profile,email

# LINE Login
# Callback URL: http://localhost:3000/api/auth/oauth/line/callback
# Production callback URL: https://your-api-domain.com/api/auth/oauth/line/callback
# LINE_CLIENT_ID must be the numeric LINE Login Channel ID, not the Channel secret.
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
LINE_SCOPE=openid profile email

# OCR for scanned PDFs and scanned images
ENABLE_OCR=false
OCR_LANG=tha+eng
# TESSERACT_COMMAND=C:\Program Files\Tesseract-OCR\tesseract.exe
# OCR_PYTHON_COMMAND=python
# OCR_PSM=3
# TESSERACT_JS_LANG_PATH=./

# ThaID Login
# Callback URL: http://localhost:3000/api/auth/oauth/thaid/callback
# Production callback URL: https://your-api-domain.com/api/auth/oauth/thaid/callback
# Note: ThaID integration requires approval / onboarding with DOPA Digital ID.
# DOPA/ThaiD will provide the client credentials and OAuth/OIDC endpoints for your environment.
THAID_CLIENT_ID=
THAID_CLIENT_SECRET=
THAID_AUTH_URL=
THAID_TOKEN_URL=
THAID_PROFILE_URL=
THAID_SCOPE=openid profile email
