PORT=3000

# Local MySQL / Railway public proxy
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=read_and_voice

# Railway MySQL also works with its default variable names:
# MYSQLHOST=
# MYSQLPORT=
# MYSQLUSER=
# MYSQLPASSWORD=
# MYSQLDATABASE=
# DATABASE_URL=

JWT_SECRET=change-this-secret

FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000

# Facebook Login
# Callback URL: http://localhost:3000/api/auth/oauth/facebook/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# LINE Login
# Callback URL: http://localhost:3000/api/auth/oauth/line/callback
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
