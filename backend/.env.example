PORT=3000

# Local MySQL / Railway public proxy
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=read_and_voice

# Railway MySQL also works with its default variable names:
# MYSQLHOST=
# MYSQLPORT=
# MYSQLUSER=
# MYSQLPASSWORD=
# MYSQLDATABASE=
# DATABASE_URL=
DB_CONNECT_TIMEOUT_MS=8000

# Guest book preview controls
GUEST_PREVIEW_PAGE_LIMIT=1
GUEST_PREVIEW_CHAR_LIMIT=1500

JWT_SECRET=change-this-secret

FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000
MOCK_PAYMENT_WEBHOOK_SECRET=

# ThaID Login
# Callback URL: http://localhost:3000/api/auth/oauth/thaid/callback
# Note: ThaID production integration requires approval / onboarding with DOPA Digital ID / NDID
THAID_CLIENT_ID=
THAID_CLIENT_SECRET=
THAID_AUTH_URL=
THAID_TOKEN_URL=
THAID_PROFILE_URL=
THAID_SCOPE=openid profile email
