{
  "name": "read-and-voice",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-all.cjs",
    "dev:frontend": "vite",
    "dev:cloud-api": "node scripts/dev-cloud-api.cjs",
    "dev:backend": "npm --prefix backend run dev",
    "build": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json",
    "check": "npm run type-check && npm run check:voice-commands && npm --prefix backend run config:check && npm run build",
    "check:category-scopes": "node backend/services/scripts/checkCategoryScopes.js",
    "check:i18n-hardcoded": "node scripts/auditI18nHardcoded.mjs",
    "check:voice-commands": "node scripts/checkVoiceCommands.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "^3.5.30",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.0",
    "nodemon": "^3.1.14",
    "typescript": "~5.9.3",
    "vite": "^8.0.1",
    "vue-tsc": "^3.2.5"
  }
}
